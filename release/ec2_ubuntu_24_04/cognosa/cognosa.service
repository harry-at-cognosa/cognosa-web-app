[Unit]
Description=Cognosa Webapp (docker compose stack in /home/ubuntu/cognosa)
After=docker.service network-online.target
Requires=docker.service

[Service]
# oneshot + RemainAfterExit: systemd starts/stops the stack but does not stay
# attached, so deploy.sh can rebuild/restart individual services freely.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/cognosa
ExecStart=/usr/bin/docker compose -f /home/ubuntu/cognosa/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /home/ubuntu/cognosa/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
